<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:paddingTop="8dp">

        <!-- "Informacja": do kogo pójdzie usprawiedliwienie -->
        <com.google.android.material.card.MaterialCardView
            style="?materialCardViewFilledStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/tutorInfo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="12dp"
                android:textAppearance="?textAppearanceBodyMedium"
                tools:text="Usprawiedliwienie zostanie wysłane do wychowawcy: Kowalska Anna." />
        </com.google.android.material.card.MaterialCardView>

        <ProgressBar
            android:id="@+id/progressBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginVertical="16dp" />

        <LinearLayout
            android:id="@+id/form"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            tools:visibility="visible">

            <!-- Usprawiedliw: wybrane dni / kilka godzin w wybranym dniu -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/excuse_mode"
                android:textAppearance="?textAppearanceLabelLarge" />

            <RadioGroup
                android:id="@+id/modeGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <RadioButton
                    android:id="@+id/modeDays"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="@string/excuse_mode_days" />

                <RadioButton
                    android:id="@+id/modeHours"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/excuse_mode_hours" />
            </RadioGroup>

            <!-- Okres usprawiedliwienia: od / do (w trybie godzin tylko "Data") -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/dateFromLayout"
                    style="?textInputOutlinedDenseStyle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="4dp"
                    android:layout_weight="1"
                    android:hint="@string/excuse_date_from">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/dateFrom"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:focusable="false" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/dateToLayout"
                    style="?textInputOutlinedDenseStyle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:layout_weight="1"
                    android:hint="@string/excuse_date_to">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/dateTo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:focusable="false" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>

            <!-- Tryb godzin: lista lekcji z /eusprawiedliwienia_rodzic_godziny -->
            <LinearLayout
                android:id="@+id/lessonsContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="vertical"
                android:visibility="gone"
                tools:visibility="visible" />

            <!-- Treść -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/reasonLayout"
                style="?textInputOutlinedStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:hint="@string/excuse_reason">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/reason"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="top"
                    android:inputType="textMultiLine|textCapSentences"
                    android:minLines="4" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Załącznik -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/attachmentButton"
                style="?materialButtonOutlinedStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/excuse_attachment" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/excuse_attachment_hint"
                android:textAppearance="?textAppearanceBodySmall" />

            <!-- Powiadom nauczycieli o planowanej nieobecności -->
            <CheckBox
                android:id="@+id/notifyTeachers"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/excuse_notify_teachers" />

            <TextView
                android:id="@+id/notifyTeachersHint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:textAppearance="?textAppearanceBodySmall"
                tools:text="@string/excuse_notify_teachers_hint_future" />
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
